[Unit]
Description=opensecmon - security advisories for your own software and hardware
Documentation=https://github.com/tomCSLK/opensecmon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opensecmon
Group=opensecmon
ExecStart=/usr/bin/opensecmon --config /etc/opensecmon/config.toml serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# /var/lib/opensecmon (database), created and owned by the service user, mode 0750.
StateDirectory=opensecmon
StateDirectoryMode=0750
UMask=0077

# Hardening: the service needs the network (its HTTPS listener or the one behind the reverse proxy, SMTP, the advisory
# feeds over HTTPS) and its state directory, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
