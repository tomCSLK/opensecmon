# Texte der Browser-Skripte (static/*.js). Ohne Fluent-Variablen: %1, %2 setzt das Skript ein.
js-date = DD.MM.YYYY
js-theme-to-light = Helles Design
js-theme-to-dark = Dunkles Design
js-copy = Kopieren
js-copied = Kopiert
js-reading = Abfrage läuft …
js-csv-too-large = Die Datei ist größer als 1 MiB.
js-csv-loaded = %1 geladen. Jetzt „Vorschau“ wählen.
js-translate-busy = Wird übersetzt …
js-translate-download = Das Sprachmodell wird geladen: %1 %
js-translate-done = Maschinell im Browser übersetzt. Maßgeblich ist der Originaltext.
js-translate-failed = Die Übersetzung hat nicht geklappt.
